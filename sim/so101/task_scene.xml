<mujoco model="so101_task">
  <!-- SO-101 + white tabletop + red brick + open tray (the "box") + cameras matched to
       the svla_so101_pickplace dataset: up = diagonal over-the-shoulder top, side = low
       front, plus a wrist camera (defined in the robot file). -->
  <include file="so101_new_calib.xml"/>

  <!-- Contact solver tuned for stable grasping (from ggand0/pick-101): elliptic friction
       cone + noslip + high impratio + stiff contacts stop the cube wobbling/slipping out. -->
  <option timestep="0.002" gravity="0 0 -9.81" noslip_iterations="3" impratio="10" cone="elliptic"/>
  <default>
    <geom solref="0.001 1" solimp="0.99 0.99 0.001"/>
  </default>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.45 0.45 0.45" specular="0.1 0.1 0.1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.95 0.95 0.96" rgb2="0.78 0.80 0.85" width="512" height="512"/>
    <material name="tabletop" rgba="0.93 0.93 0.94 1" reflectance="0.05"/>
    <material name="tray" rgba="0.85 0.87 0.9 0.45"/>
    <material name="tray_edge" rgba="0.95 0.55 0.15 0.85"/>
  </asset>

  <worldbody>
    <light pos="0.1 0.0 1.2" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 0" material="tabletop"/>

    <!-- red 3x3x3cm cube to pick (sized to fit the SO-101 gripper gap, per ggand0/pick-101) -->
    <body name="cube" pos="0.27 0.0 0.015">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" rgba="0.86 0.15 0.13 1"
            mass="0.03" friction="0.5 0.05 0.001"/>
    </body>

    <!-- open tray (the "box" target): transparent base + orange-ish low walls -->
    <body name="box" pos="0.34 0.02 0.0">
      <geom type="box" pos="0 0 0.001" size="0.05 0.035 0.001" material="tray" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.05 0 0.012" size="0.003 0.035 0.012" material="tray_edge" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.05 0 0.012" size="0.003 0.035 0.012" material="tray_edge" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0.035 0.012" size="0.05 0.003 0.012" material="tray_edge" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 -0.035 0.012" size="0.05 0.003 0.012" material="tray_edge" contype="0" conaffinity="0"/>
    </body>

    <!-- invisible aim point at the workspace centre (cameras orient toward it) -->
    <body name="viewtarget" pos="0.27 0.0 0.06">
      <geom type="sphere" size="0.001" rgba="0 0 0 0" contype="0" conaffinity="0"/>
    </body>

    <!-- up: diagonal overhead looking down at the workspace (cube + tray + full arm in frame) -->
    <camera name="up" pos="0.544 -0.274 0.491" mode="targetbody" target="viewtarget"/>
    <!-- side: low front view, pulled back so the WHOLE robot is in frame -->
    <camera name="side" pos="0.28 -0.55 0.28" mode="targetbody" target="viewtarget"/>
  </worldbody>
</mujoco>
