<mujoco model="so101_task">
  <!-- SO-101 (LeRobot arm) + floor + a pickable cube + up/side cameras.
       Simple scene to run SmolVLA closed-loop and stream telemetry. -->
  <include file="so101_new_calib.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>

    <!-- pickable cube (free body) in front of the arm -->
    <body name="cube" pos="0.18 0.0 0.0125">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.0125 0.0125 0.0125" rgba="0.9 0.2 0.2 1"
            mass="0.02" friction="1.0 0.01 0.001"/>
    </body>

    <!-- target marker (visual only) -->
    <body name="target" pos="0.18 0.12 0.001">
      <geom name="target" type="cylinder" size="0.025 0.001" rgba="0.2 0.7 0.9 0.4" contype="0" conaffinity="0"/>
    </body>

    <!-- cameras matching the svla_so101_pickplace dataset (up = top-down, side) -->
    <camera name="up" pos="0.09 0.0 0.5" xyaxes="1 0 0 0 1 0"/>
    <camera name="side" pos="0.16 -0.38 0.22" mode="targetbody" target="base"/>
  </worldbody>
</mujoco>
